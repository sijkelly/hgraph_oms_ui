# Backend origin; leave empty in development (the Vite dev server proxies /api and /ws)
VITE_API_BASE_URL=

# dev: pick a demo account, sent to the API as X-User-Id (API running with AUTH_MODE=header)
# sso: sign in through an OpenID Connect provider (API running with AUTH_MODE=oidc)
VITE_AUTH_MODE=dev

# --- sso mode ---
# The provider's issuer URL: the same value as the API's OIDC_ISSUER
VITE_OIDC_ISSUER=
# This application's client ID at the provider. Register it as a public (SPA) client with
# the redirect URI <this app's origin>/auth/callback
VITE_OIDC_CLIENT_ID=
# Scopes to request (default: openid profile)
VITE_OIDC_SCOPE=
# The API's audience, for providers that need it in the sign-in request (e.g. Auth0)
VITE_OIDC_AUDIENCE=
